    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "dissentId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Dissentid",
      "type": "string"
    },
    "event": {
      "$ref": "#/$defs/ResearchEventIdentity"
    },
    "evidenceRefs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Evidencerefs",
      "type": "array",
      "uniqueItems": true
    },
    "experimentRevision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Experimentrevision",
      "type": "integer"
