{
  "$defs": {
    "ExpectedDirection": {
      "enum": [
        "increase",
        "decrease",
        "unchanged",
        "range",
        "unknown"
      ],
      "title": "ExpectedDirection",
      "type": "string"
    },
    "ProposalPrediction": {
      "additionalProperties": false,
      "properties": {
        "expectedDirection": {
          "$ref": "#/$defs/ExpectedDirection"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        },
        "metric": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "statement": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "expectedDirection"
      ],
      "title": "ProposalPrediction",
      "type": "object"
    },
    "ProposalRequestActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "ai"
          ],
          "title": "Kind",
          "type": "string"
        },
        "modelId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "ProposalRequestActor",
      "type": "object"
    },
    "ResearchEventIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$",
          "title": "Id",
          "type": "string"
        },
        "time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "time"
      ],
      "title": "ResearchEventIdentity",
      "type": "object"
    },
    "RiskAssessment": {
      "additionalProperties": false,
      "properties": {
        "cost": {
          "maxLength": 4000,
          "minLength": 0,
          "title": "Cost",
          "type": "string"
        },
        "data": {
          "maxLength": 4000,
          "minLength": 0,
          "title": "Data",
          "type": "string"
        },
        "method": {
          "maxLength": 4000,
          "minLength": 0,
          "title": "Method",
          "type": "string"
        },
        "safety": {
          "maxLength": 4000,
          "minLength": 0,
          "title": "Safety",
          "type": "string"
        }
      },
      "required": [
        "data",
        "method",
        "safety",
        "cost"
      ],
      "title": "RiskAssessment",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/proposal-submit-request/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ProposalRequestActor"
    },
    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "event": {
      "$ref": "#/$defs/ResearchEventIdentity"
    },
    "evidenceRefs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Evidencerefs",
      "type": "array",
      "uniqueItems": true
    },
    "experimentRevision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Experimentrevision",
      "type": "integer"
    },
    "falsificationConditions": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Falsificationconditions",
      "type": "array"
    },
    "kind": {
      "const": "ProposalSubmitRequest",
      "title": "Kind",
      "type": "string"
    },
    "predictions": {
      "items": {
        "$ref": "#/$defs/ProposalPrediction"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Predictions",
      "type": "array"
    },
    "projectId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Projectid",
      "type": "string"
    },
    "proposalId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Proposalid",
      "type": "string"
    },
    "proposedSpecDigest": {
      "maxLength": 75,
      "minLength": 75,
      "pattern": "^jcs-sha256:[0-9a-f]{64}$",
      "title": "Proposedspecdigest",
      "type": "string"
    },
    "rationale": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "riskAssessment": {
      "$ref": "#/$defs/RiskAssessment"
    },
    "source": {
      "maxLength": 2048,
      "minLength": 1,
