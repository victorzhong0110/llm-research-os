    "specDiffDigest": {
      "maxLength": 75,
      "minLength": 75,
      "pattern": "^jcs-sha256:[0-9a-f]{64}$",
      "title": "Specdiffdigest",
      "type": "string"
    },
    "streamid": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Streamid",
      "type": "string"
    },
    "subject": {
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$",
      "title": "Subject",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "projectId",
    "experimentRevision",
    "source",
    "subject",
    "streamid",
    "actor",
    "event",
    "proposalId",
    "specDiffDigest",
    "proposedSpecDigest",
    "rationale",
    "predictions",
    "falsificationConditions",
    "riskAssessment",
    "evidenceRefs"
  ],
  "title": "ProposalSubmitRequestDocument",
  "type": "object"
}
