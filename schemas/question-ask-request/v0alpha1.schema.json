{
  "$defs": {
    "QuestionRequestActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ai",
            "system"
          ],
          "title": "Kind",
          "type": "string"
        },
        "modelId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "QuestionRequestActor",
      "type": "object"
    },
    "ResearchEventIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$",
          "title": "Id",
          "type": "string"
        },
        "time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "time"
      ],
      "title": "ResearchEventIdentity",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/question-ask-request/v0alpha1.schema.json",
