          "title": "Code",
          "type": "string"
        },
        "kind": {
          "const": "LocalApiError",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "code",
        "message"
      ],
      "title": "ErrorDocument",
      "type": "object"
    },
