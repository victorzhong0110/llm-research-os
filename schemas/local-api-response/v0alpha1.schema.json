{
  "$defs": {
    "ArtifactDocument": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "researchos.dev/local-api/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "byteLength": {
          "minimum": 0,
          "title": "Bytelength",
          "type": "integer"
        },
        "digest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "inline": {
          "title": "Inline",
          "type": "boolean"
        },
        "kind": {
          "const": "ArtifactView",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "verification": {
          "default": "not-inlined",
          "enum": [
            "verified",
            "not-inlined"
          ],
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "digest",
        "byteLength",
        "inline"
      ],
      "title": "ArtifactDocument",
      "type": "object"
    },
    "CapabilitiesDocument": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "researchos.dev/local-api/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "kind": {
          "const": "Capabilities",
          "title": "Kind",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/LimitsDocument"
        },
        "pollFallbackSeconds": {
          "exclusiveMinimum": 0,
          "title": "Pollfallbackseconds",
          "type": "number"
        },
        "readOnly": {
          "title": "Readonly",
          "type": "boolean"
        },
        "session": {
          "$ref": "#/$defs/SessionDetails"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "readOnly",
        "limits",
        "session",
        "pollFallbackSeconds"
      ],
      "title": "CapabilitiesDocument",
      "type": "object"
    },
    "CommandReceipt": {
      "additionalProperties": false,
      "description": "Result of one browser-dispatched shared command.\n\nR11's honesty rule lives in this shape: ``disposition`` says whether the\ncommand was newly committed or replayed from a prior receipt, and the\nresult carries ``observedStop``/``launchAllowed`` so the client can never\nrender an accepted request as an observed process outcome.",
      "properties": {
        "actorId": {
          "title": "Actorid",
          "type": "string"
        },
        "apiVersion": {
          "const": "researchos.dev/application/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "artifactDigests": {
          "items": {
            "type": "string"
          },
          "title": "Artifactdigests",
          "type": "array"
        },
        "commandId": {
          "title": "Commandid",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "committed",
            "replayed"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "expectedHead": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expectedhead"
        },
        "expectedRevision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expectedrevision"
        },
        "factEventIds": {
          "items": {
            "type": "string"
          },
          "title": "Facteventids",
          "type": "array"
        },
        "kind": {
          "const": "ApplicationReceipt",
          "title": "Kind",
          "type": "string"
        },
        "observedHead": {
          "minimum": 0,
          "title": "Observedhead",
          "type": "integer"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "requestDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Requestdigest",
          "type": "string"
        },
        "result": {
          "additionalProperties": true,
          "title": "Result",
          "type": "object"
        },
        "resultDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Resultdigest",
          "type": "string"
        },
        "submittedAt": {
          "title": "Submittedat",
          "type": "string"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "commandId",
        "actorId",
        "submittedAt",
        "operation",
        "requestDigest",
        "observedHead",
        "disposition",
        "factEventIds",
        "artifactDigests",
        "resultDigest",
        "result"
      ],
      "title": "CommandReceipt",
      "type": "object"
    },
    "DocumentPreviewDocument": {
