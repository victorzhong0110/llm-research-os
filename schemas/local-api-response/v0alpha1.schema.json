        "apiVersion": {
          "const": "researchos.dev/local-api/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "highWaterMark": {
          "minimum": 0,
          "title": "Highwatermark",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/EventItem"
          },
          "maxItems": 100,
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "const": "ActivitySnapshot",
          "title": "Kind",
          "type": "string"
        },
        "olderAvailable": {
          "title": "Olderavailable",
          "type": "boolean"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "items",
        "highWaterMark",
        "olderAvailable"
      ],
      "title": "ActivitySnapshot",
      "type": "object"
    },
    "AgentAsk": {
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "minimum": 1,
          "title": "Expectedrevision",
          "type": "integer"
        },
        "kind": {
          "const": "DashboardAgentAsk",
          "default": "DashboardAgentAsk",
          "title": "Kind",
          "type": "string"
        },
        "projectId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Projectid",
          "type": "string"
        },
        "prompt": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "requestId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Requestid",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                "type": "string"
              },
              "maxItems": 2000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        }
      },
      "required": [
        "projectId",
        "requestId",
        "expectedRevision",
        "prompt"
      ],
      "title": "AgentAsk",
      "type": "object"
    },
