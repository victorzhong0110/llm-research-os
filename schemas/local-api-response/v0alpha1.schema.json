        "code": {
          "enum": [
            "body-too-large",
            "concurrency-exhausted",
            "command-refused",
            "content-type-unsupported",
            "csrf-invalid",
            "document-hostile",
            "document-invalid",
            "event-store-unavailable",
            "host-forbidden",
            "internal-error",
            "method-not-allowed",
            "not-found",
            "origin-forbidden",
            "parameter-invalid",
            "query-timeout",
            "session-expired",
            "session-required",
            "bootstrap-invalid",
            "bootstrap-consumed",
            "workspace-invalid"
