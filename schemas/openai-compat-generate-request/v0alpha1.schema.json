{
  "$defs": {
    "CompatRequestActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "ai",
          "title": "Kind",
          "type": "string"
        },
        "modelId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Modelid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "modelId"
      ],
      "title": "CompatRequestActor",
      "type": "object"
    },
    "KernelCapability": {
      "enum": [
        "simulate",
        "read.local_evidence",
        "read.external_api",
        "write.experiment_draft"
      ],
      "title": "KernelCapability",
      "type": "string"
    },
    "ModelCapability": {
      "enum": [
        "generate",
        "stream",
        "json-schema",
        "tools",
        "image",
        "embedding",
        "logprobs",
        "seed"
      ],
      "title": "ModelCapability",
      "type": "string"
    },
    "ModelEventIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$",
          "title": "Id",
          "type": "string"
        },
        "time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "time"
      ],
      "title": "ModelEventIdentity",
      "type": "object"
    },
    "SecretBackend": {
      "enum": [
        "env",
        "file",
        "keyring"
      ],
      "title": "SecretBackend",
      "type": "string"
    },
    "SecretRef": {
      "additionalProperties": false,
      "description": "Handle to a secret slot. Callers must not place the secret value here.",
      "properties": {
        "apiVersion": {
          "const": "researchos.dev/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "backend": {
          "$ref": "#/$defs/SecretBackend"
        },
        "kind": {
          "const": "SecretRef",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "backend",
        "name"
      ],
      "title": "SecretRef",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/openai-compat-generate-request/v0alpha1.schema.json",
