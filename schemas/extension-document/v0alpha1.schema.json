        "contractVersion": {
          "const": "v0alpha1",
          "title": "Contractversion",
          "type": "string"
        },
        "diagnostics": {
          "additionalProperties": {
            "maxLength": 200,
            "type": "string"
          },
          "maxProperties": 16,
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Diagnostics",
          "type": "object"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "entryModule": {
          "anyOf": [
            {
              "maxLength": 262144,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entrymodule"
        },
        "extensionContractVersion": {
          "const": "v0alpha1",
          "title": "Extensioncontractversion",
          "type": "string"
        },
        "grantedPermissions": {
          "items": {
            "enum": [
              "artifacts.read",
              "events.read",
              "evidence.read",
              "ledger.read",
              "metrics.read"
            ],
            "type": "string"
          },
          "maxItems": 0,
          "title": "Grantedpermissions",
          "type": "array"
        },
        "hasEntryModule": {
          "title": "Hasentrymodule",
          "type": "boolean"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "InstalledExtension",
          "title": "Kind",
          "type": "string"
        },
        "manifestDigest": {
          "pattern": "^jcs-sha256:[0-9a-f]{64}$",
          "title": "Manifestdigest",
          "type": "string"
        },
        "originName": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Originname",
          "type": "string"
        },
        "refusedPermissions": {
          "items": {
            "enum": [
              "artifacts.read",
              "events.read",
              "evidence.read",
              "ledger.read",
              "metrics.read"
            ],
            "type": "string"
          },
          "maxItems": 0,
          "title": "Refusedpermissions",
          "type": "array"
        },
        "requestedPermissions": {
          "items": {
            "enum": [
              "artifacts.read",
              "events.read",
              "evidence.read",
              "ledger.read",
              "metrics.read"
            ],
            "type": "string"
          },
          "maxItems": 16,
          "title": "Requestedpermissions",
          "type": "array"
        },
        "trust": {
          "enum": [
            "inert",
            "reviewed-same-user"
          ],
          "title": "Trust",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "contractVersion",
        "id",
        "version",
        "extensionContractVersion",
        "manifestDigest",
        "requestedPermissions",
        "compatiblePermissions",
        "grantedPermissions",
        "refusedPermissions",
        "entryModule",
        "hasEntryModule",
        "diagnostics",
        "trust",
        "enabled",
        "originName"
      ],
      "title": "InstalledView",
      "type": "object"
    },
