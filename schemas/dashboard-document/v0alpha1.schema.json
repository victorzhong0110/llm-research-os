{
  "$defs": {
    "Appearance": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "default": "#262626",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Accent",
          "type": "string"
        },
        "background": {
          "default": "#f5f5f4",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background",
          "type": "string"
        },
        "density": {
          "default": "comfortable",
          "enum": [
            "comfortable",
            "compact"
          ],
          "title": "Density",
          "type": "string"
        },
        "skin": {
          "default": "graphite",
          "enum": [
            "graphite",
            "paper",
            "custom"
          ],
          "title": "Skin",
          "type": "string"
        },
        "textScale": {
          "default": 1,
          "maximum": 1.4,
          "minimum": 0.9,
          "title": "Textscale",
          "type": "number"
        }
      },
      "title": "Appearance",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "entityId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entityid"
        },
        "source": {
          "enum": [
            "workspace",
            "runs",
            "research",
            "events",
            "telemetry"
          ],
          "title": "Source",
          "type": "string"
        },
        "sourceId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourceid"
        }
      },
      "required": [
        "source"
      ],
      "title": "Binding",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "body": {
          "default": "",
          "maxLength": 4000,
          "title": "Body",
          "type": "string"
        },
        "collapsed": {
          "default": false,
          "title": "Collapsed",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "parentId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parentid"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "renderer": {
          "default": "summary",
          "enum": [
            "summary",
            "metric",
            "table",
            "chart",
            "timeline"
          ],
          "title": "Renderer",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "enum": [
            "group",
            "project",
            "run",
            "agent",
            "research",
            "evaluation",
            "resource",
            "provider",
            "dataset",
            "model",
            "service",
            "pool",
            "availability",
            "cost",
            "access",
            "recovery",
            "note",
            "custom"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "position"
      ],
      "title": "Component",
      "type": "object"
    },
    "DashboardDocument": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "researchos.dev/dashboard/v0alpha1",
          "default": "researchos.dev/dashboard/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "author": {
          "default": "system",
          "maxLength": 120,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "authorKind": {
          "default": "system",
          "enum": [
            "human",
            "agent",
            "system"
          ],
          "title": "Authorkind",
          "type": "string"
        },
        "kind": {
          "const": "DashboardDocument",
          "default": "DashboardDocument",
          "title": "Kind",
          "type": "string"
        },
        "projectId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Projectid",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/MapState"
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updatedat"
        }
      },
      "required": [
        "projectId"
      ],
      "title": "DashboardDocument",
      "type": "object"
    },
    "DashboardWrite": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "researchos.dev/dashboard/v0alpha1",
          "default": "researchos.dev/dashboard/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "author": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "authorKind": {
          "enum": [
            "human",
            "agent"
          ],
          "title": "Authorkind",
          "type": "string"
        },
        "expectedRevision": {
          "minimum": 0,
          "title": "Expectedrevision",
          "type": "integer"
        },
        "kind": {
          "const": "DashboardWrite",
          "default": "DashboardWrite",
          "title": "Kind",
          "type": "string"
        },
        "projectId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Projectid",
          "type": "string"
        },
        "requestId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Requestid",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/MapState"
        }
      },
      "required": [
        "projectId",
        "requestId",
        "expectedRevision",
        "author",
        "authorKind",
        "state"
      ],
      "title": "DashboardWrite",
      "type": "object"
    },
    "MapState": {
      "additionalProperties": false,
      "properties": {
        "appearance": {
          "$ref": "#/$defs/Appearance"
        },
        "components": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Component"
          },
          "maxItems": 2000,
          "title": "Components",
          "type": "array"
        },
        "relations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "maxItems": 6000,
          "title": "Relations",
          "type": "array"
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        }
      },
      "title": "MapState",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "default": 190,
          "maximum": 20000,
          "minimum": 120,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "default": 280,
          "maximum": 20000,
          "minimum": 180,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 100000,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "scope": {
          "const": "view",
          "default": "view",
          "title": "Scope",
          "type": "string"
        },
        "source": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "type": {
          "enum": [
            "dependency",
            "evidence",
            "shared",
            "peer",
            "association"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "type",
        "label"
      ],
      "title": "Relation",
      "type": "object"
    },
    "Viewport": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0,
          "maximum": 200000,
          "minimum": -200000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "maximum": 200000,
          "minimum": -200000,
          "title": "Y",
          "type": "number"
        },
        "zoom": {
          "default": 0.75,
          "maximum": 2,
          "minimum": 0.1,
          "title": "Zoom",
          "type": "number"
        }
      },
      "title": "Viewport",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/dashboard-document/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/DashboardDocument"
    },
    {
      "$ref": "#/$defs/DashboardWrite"
    }
  ]
}
