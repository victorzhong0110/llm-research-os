{
  "$defs": {
    "NativeReviewedBundleFile": {
      "additionalProperties": false,
      "description": "One Python source inside a reviewed bundle. The path is bundle-relative.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "path": {
          "maxLength": 256,
          "minLength": 4,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "title": "NativeReviewedBundleFile",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/native-reviewed-python-bundle/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Digest index of a reviewed CPU Python brick. Not an executable path.",
  "properties": {
    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "entrypoint": {
      "maxLength": 256,
      "minLength": 3,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$",
      "title": "Entrypoint",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/NativeReviewedBundleFile"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "kind": {
      "const": "NativeReviewedPythonBundle",
      "title": "Kind",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "entrypoint",
    "files"
  ],
  "title": "NativeReviewedPythonBundle",
  "type": "object"
}
