{
  "$defs": {
    "AttestationClaims": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "apiVersion": {
          "const": "researchos.dev/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "audience": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Audience",
          "type": "string"
        },
        "authority": {
          "const": "audit-attestation-only",
          "title": "Authority",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/PlanAuthorizationEventBinding"
        },
        "eventDigest": {
          "maxLength": 75,
          "minLength": 75,
          "pattern": "^jcs-sha256:[0-9a-f]{64}$",
          "title": "Eventdigest",
          "type": "string"
        },
        "eventId": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Eventid",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Expiresat",
          "type": "string"
        },
        "issuedAt": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Issuedat",
          "type": "string"
        },
        "keyId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Keyid",
          "type": "string"
        },
        "kind": {
          "const": "AuthorizationAttestation",
          "title": "Kind",
          "type": "string"
        },
        "projectId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Projectid",
          "type": "string"
        },
        "receiptId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Receiptid",
          "type": "string"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "algorithm",
        "receiptId",
        "keyId",
        "audience",
        "projectId",
        "eventId",
        "eventDigest",
        "binding",
        "issuedAt",
        "expiresAt",
        "authority"
      ],
      "title": "AttestationClaims",
      "type": "object"
    },
    "PlanAuthorizationEventBinding": {
      "additionalProperties": false,
      "description": "Exact plan and recomputed decision identity.",
      "properties": {
        "decisionDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Decisiondigest",
          "type": "string"
        },
        "planDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Plandigest",
          "type": "string"
        },
        "registryDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Registrydigest",
          "type": "string"
        },
        "specDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Specdigest",
          "type": "string"
        }
      },
      "required": [
        "specDigest",
        "registryDigest",
        "planDigest",
        "decisionDigest"
      ],
      "title": "PlanAuthorizationEventBinding",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/authorization-attestation/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "$ref": "#/$defs/AttestationClaims"
    },
    "signature": {
      "maxLength": 128,
      "minLength": 128,
      "pattern": "^[0-9a-f]{128}$",
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "claims",
    "signature"
  ],
  "title": "AuthorizationAttestation",
  "type": "object"
}
