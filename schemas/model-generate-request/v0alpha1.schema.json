{
  "$defs": {
    "ModelCapability": {
      "enum": [
        "generate",
        "stream",
        "json-schema",
        "tools",
        "image",
        "embedding",
        "logprobs",
        "seed"
      ],
      "title": "ModelCapability",
      "type": "string"
    },
    "ModelEventIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$",
          "title": "Id",
          "type": "string"
        },
        "time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "time"
      ],
      "title": "ModelEventIdentity",
      "type": "object"
    },
    "ModelRequestActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "ai",
          "title": "Kind",
          "type": "string"
        },
        "modelId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Modelid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "modelId"
      ],
      "title": "ModelRequestActor",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/model-generate-request/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ModelRequestActor"
    },
    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "callId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Callid",
      "type": "string"
    },
    "events": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelEventIdentity"
      },
      "maxProperties": 2,
      "minProperties": 2,
      "propertyNames": {
        "enum": [
          "ai.call.started",
          "ai.call.completed"
        ]
      },
      "required": [
        "ai.call.started",
        "ai.call.completed"
      ],
      "title": "Events",
      "type": "object"
    },
    "evidenceRefs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Evidencerefs",
      "type": "array",
      "uniqueItems": true
    },
    "experimentRevision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Experimentrevision",
      "type": "integer"
    },
    "fixtureId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Fixtureid",
      "type": "string"
    },
    "kind": {
      "const": "ModelGenerateRequest",
      "title": "Kind",
      "type": "string"
    },
    "projectId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Projectid",
      "type": "string"
    },
    "providerId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Providerid",
      "type": "string"
    },
    "requestedCapabilities": {
      "items": {
        "$ref": "#/$defs/ModelCapability"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Requestedcapabilities",
      "type": "array",
      "uniqueItems": true
    },
