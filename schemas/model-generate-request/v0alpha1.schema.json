  "required": [
    "apiVersion",
    "kind",
    "projectId",
    "experimentRevision",
    "source",
    "subject",
    "streamid",
    "actor",
    "callId",
    "fixtureId",
    "providerId",
    "requestedCapabilities",
    "events",
    "evidenceRefs"
