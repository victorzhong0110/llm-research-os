{
  "$defs": {
    "AuthorizationRevokeOperation": {
      "additionalProperties": false,
      "description": "Revoke an unused Worker grant. Revocation never launches or completes work.",
      "properties": {
        "eventId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Eventid",
          "type": "string"
        },
        "grantId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Grantid",
          "type": "string"
        },
        "kind": {
          "const": "authorization.revoke",
          "title": "Kind",
          "type": "string"
        },
        "reasonCode": {
          "default": "human.revoke",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Reasoncode",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "grantId",
        "eventId"
      ],
      "title": "AuthorizationRevokeOperation",
      "type": "object"
    },
    "BackupOperation": {
      "additionalProperties": false,
      "properties": {
        "destinationId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destinationid"
        },
        "imageId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Imageid",
          "type": "string"
        },
        "kind": {
          "enum": [
            "backup.verify",
            "backup.restore"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "imageId"
      ],
      "title": "BackupOperation",
      "type": "object"
    },
    "ConclusionRecordOperation": {
      "additionalProperties": false,
      "description": "Record a human conclusion. The system never supplies the judgement.",
      "properties": {
        "baseline": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Baseline",
          "type": "string"
        },
        "candidate": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Candidate",
          "type": "string"
        },
        "conclusionId": {
          "title": "Conclusionid",
          "type": "string"
        },
        "kind": {
          "const": "conclusion.record",
          "title": "Kind",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "insufficient-evidence",
            "supported",
            "unsupported"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "baseline",
        "candidate",
        "verdict",
        "rationale",
        "conclusionId"
      ],
      "title": "ConclusionRecordOperation",
      "type": "object"
    },
    "EvaluationCompareOperation": {
      "additionalProperties": false,
      "description": "Compare a baseline and a candidate result, refusing incompatible setups.",
      "properties": {
        "baseline": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Baseline",
          "type": "string"
        },
        "candidate": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Candidate",
          "type": "string"
        },
        "kind": {
          "const": "evaluation.compare",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "baseline",
        "candidate"
      ],
      "title": "EvaluationCompareOperation",
      "type": "object"
    },
    "EvaluationRunOperation": {
      "additionalProperties": false,
      "description": "Compute one real evaluation over the fixed held-out set.\n\nReads the committed dataset and the registered predictors, writes a detail\nartifact, and appends no per-sample events. A caller may add their own\npredictor later by registering it; this slice evaluates the baseline and the\nthreshold candidate only, and says so.",
      "properties": {
        "kind": {
          "const": "evaluation.run",
          "title": "Kind",
          "type": "string"
        },
        "mode": {
          "enum": [
            "candidate",
            "majority",
            "threshold"
          ],
          "title": "Mode",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "kind",
        "mode"
      ],
      "title": "EvaluationRunOperation",
      "type": "object"
    },
    "NativeOperation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "native.start",
                  "native.restore"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "materialDigest": {
                "type": "string"
              }
            },
            "required": [
              "materialDigest"
            ]
          }
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "native.start",
            "native.restore",
            "native.observe",
            "native.inspect"
          ],
          "title": "Kind",
          "type": "string"
        },
        "materialDigest": {
          "anyOf": [
            {
              "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Materialdigest"
        },
        "profileId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Profileid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "profileId"
      ],
      "title": "NativeOperation",
      "type": "object"
    },
    "PlanDryRunOperation": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Document",
          "type": "string"
        },
        "kind": {
          "const": "plan.dry-run",
          "title": "Kind",
          "type": "string"
        },
        "registry": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1F\\x7F]+$",
            "type": "string"
          },
          "title": "Registry",
          "type": "array"
        },
        "workflowId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflowid"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "title": "PlanDryRunOperation",
      "type": "object"
    },
    "PlanPreflightOperation": {
      "additionalProperties": false,
      "description": "Show what a plan would require, without authorizing anything.\n\nThe browser must be able to display exact plan identity, target,\npermissions, supported/enforced limits and resource or budget requirements\n*before* a human authorizes it. This operation therefore reads only: it\nmints no grant, records no fact, and never reports a launch as allowed.",
      "properties": {
        "document": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Document",
          "type": "string"
        },
        "kind": {
          "const": "plan.preflight",
          "title": "Kind",
          "type": "string"
        },
        "registry": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1F\\x7F]+$",
            "type": "string"
          },
          "title": "Registry",
          "type": "array"
        },
        "workflowId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflowid"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "title": "PlanPreflightOperation",
      "type": "object"
    },
    "ProposalSubmitOperation": {
      "additionalProperties": false,
      "description": "Append one proposal bound to a base revision and a server-derived diff.\n\nThe document supplies its own ``experimentRevision``; a proposal whose\nrevision is not the current head is refused, so a stale proposal cannot\noverwrite a newer revision.",
      "properties": {
        "kind": {
          "const": "proposal.submit",
          "title": "Kind",
          "type": "string"
        },
        "request": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Request",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "request"
      ],
      "title": "ProposalSubmitOperation",
      "type": "object"
    },
    "ProposalValidateOperation": {
      "additionalProperties": false,
      "description": "Validate one proposal document and resolve its citations. Appends nothing.\n\nGenerated or hand-written proposal text becomes a draft only after it has\npassed this check, so an unresolved citation is refused before a proposal can\nexist, rather than being discovered later.",
      "properties": {
        "kind": {
          "const": "proposal.validate",
          "title": "Kind",
          "type": "string"
        },
        "request": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Request",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "request"
      ],
      "title": "ProposalValidateOperation",
      "type": "object"
    },
    "ResearchDecisionOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "research.decision",
          "title": "Kind",
          "type": "string"
        },
        "request": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Request",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "request"
      ],
      "title": "ResearchDecisionOperation",
      "type": "object"
    },
    "ResearchLedgerOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "research.ledger",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ResearchLedgerOperation",
      "type": "object"
    },
    "RevisionListOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "revision.list",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RevisionListOperation",
      "type": "object"
    },
    "RunCancelOperation": {
      "additionalProperties": false,
      "description": "Request cancellation of a Run or one active Attempt.\n\nA request is not an outcome. The receipt reports that the request was\ncommitted; the observed stop, if any, arrives as a later fact.",
      "properties": {
        "kind": {
          "const": "run.cancel",
          "title": "Kind",
          "type": "string"
        },
        "request": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Request",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "request"
      ],
      "title": "RunCancelOperation",
      "type": "object"
    },
    "RunShowOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "run.show",
          "title": "Kind",
          "type": "string"
        },
        "runId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Runid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "runId"
      ],
      "title": "RunShowOperation",
      "type": "object"
    },
    "RunSimulateOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "run.simulate",
          "title": "Kind",
          "type": "string"
        },
        "registry": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1F\\x7F]+$",
            "type": "string"
          },
          "title": "Registry",
          "type": "array"
        },
        "request": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Request",
          "type": "string"
        },
        "spec": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Spec",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "spec",
        "request"
      ],
      "title": "RunSimulateOperation",
      "type": "object"
    },
    "SpecDiffOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "spec.diff",
          "title": "Kind",
          "type": "string"
        },
        "new": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "New",
          "type": "string"
        },
        "old": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Old",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "old",
        "new"
      ],
      "title": "SpecDiffOperation",
      "type": "object"
    },
    "SpecValidateOperation": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Document",
          "type": "string"
        },
        "kind": {
          "const": "spec.validate",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "title": "SpecValidateOperation",
      "type": "object"
    },
    "WorkspaceShowOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "workspace.show",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "WorkspaceShowOperation",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/application-command/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One identity-bound command. Callers supply identity, time, and expected head.",
  "properties": {
    "actorId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Actorid",
      "type": "string"
    },
    "apiVersion": {
      "const": "researchos.dev/application/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "commandId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Commandid",
      "type": "string"
    },
    "expectedHead": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expectedhead"
    },
    "expectedRevision": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expectedrevision"
    },
    "kind": {
      "const": "ApplicationCommand",
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "discriminator": {
        "mapping": {
          "authorization.revoke": "#/$defs/AuthorizationRevokeOperation",
          "backup.restore": "#/$defs/BackupOperation",
          "backup.verify": "#/$defs/BackupOperation",
          "conclusion.record": "#/$defs/ConclusionRecordOperation",
          "evaluation.compare": "#/$defs/EvaluationCompareOperation",
          "evaluation.run": "#/$defs/EvaluationRunOperation",
          "native.inspect": "#/$defs/NativeOperation",
          "native.observe": "#/$defs/NativeOperation",
          "native.restore": "#/$defs/NativeOperation",
          "native.start": "#/$defs/NativeOperation",
          "plan.dry-run": "#/$defs/PlanDryRunOperation",
          "plan.preflight": "#/$defs/PlanPreflightOperation",
          "proposal.submit": "#/$defs/ProposalSubmitOperation",
          "proposal.validate": "#/$defs/ProposalValidateOperation",
          "research.decision": "#/$defs/ResearchDecisionOperation",
          "research.ledger": "#/$defs/ResearchLedgerOperation",
          "revision.list": "#/$defs/RevisionListOperation",
          "run.cancel": "#/$defs/RunCancelOperation",
          "run.show": "#/$defs/RunShowOperation",
          "run.simulate": "#/$defs/RunSimulateOperation",
          "spec.diff": "#/$defs/SpecDiffOperation",
          "spec.validate": "#/$defs/SpecValidateOperation",
          "workspace.show": "#/$defs/WorkspaceShowOperation"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SpecValidateOperation"
        },
        {
          "$ref": "#/$defs/SpecDiffOperation"
        },
        {
          "$ref": "#/$defs/PlanDryRunOperation"
        },
        {
          "$ref": "#/$defs/ResearchLedgerOperation"
        },
        {
          "$ref": "#/$defs/ResearchDecisionOperation"
        },
        {
          "$ref": "#/$defs/RevisionListOperation"
        },
        {
          "$ref": "#/$defs/RunShowOperation"
        },
        {
          "$ref": "#/$defs/RunSimulateOperation"
        },
        {
          "$ref": "#/$defs/WorkspaceShowOperation"
        },
        {
          "$ref": "#/$defs/ConclusionRecordOperation"
        },
        {
          "$ref": "#/$defs/EvaluationCompareOperation"
        },
        {
          "$ref": "#/$defs/EvaluationRunOperation"
        },
        {
          "$ref": "#/$defs/PlanPreflightOperation"
        },
        {
          "$ref": "#/$defs/ProposalSubmitOperation"
        },
        {
          "$ref": "#/$defs/ProposalValidateOperation"
        },
        {
          "$ref": "#/$defs/RunCancelOperation"
        },
        {
          "$ref": "#/$defs/AuthorizationRevokeOperation"
        },
        {
          "$ref": "#/$defs/NativeOperation"
        },
        {
          "$ref": "#/$defs/BackupOperation"
        }
      ],
      "title": "Operation"
    },
    "submittedAt": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Submittedat",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "commandId",
    "actorId",
    "submittedAt",
    "operation"
  ],
  "title": "ApplicationCommand",
  "type": "object"
}
