{
  "$defs": {
    "PlanDryRunOperation": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Document",
          "type": "string"
        },
        "kind": {
          "const": "plan.dry-run",
          "title": "Kind",
          "type": "string"
        },
        "registry": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1F\\x7F]+$",
            "type": "string"
          },
          "title": "Registry",
          "type": "array"
        },
        "workflowId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflowid"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "title": "PlanDryRunOperation",
      "type": "object"
    },
    "ResearchDecisionOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "research.decision",
          "title": "Kind",
          "type": "string"
        },
        "request": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Request",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "request"
      ],
      "title": "ResearchDecisionOperation",
      "type": "object"
    },
    "ResearchLedgerOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "research.ledger",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ResearchLedgerOperation",
      "type": "object"
    },
    "RevisionListOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "revision.list",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RevisionListOperation",
      "type": "object"
    },
    "RunShowOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "run.show",
          "title": "Kind",
          "type": "string"
        },
        "runId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Runid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "runId"
      ],
      "title": "RunShowOperation",
      "type": "object"
    },
    "RunSimulateOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "run.simulate",
          "title": "Kind",
          "type": "string"
        },
        "registry": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1F\\x7F]+$",
            "type": "string"
          },
          "title": "Registry",
          "type": "array"
        },
        "request": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Request",
          "type": "string"
        },
        "spec": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Spec",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "spec",
        "request"
      ],
      "title": "RunSimulateOperation",
      "type": "object"
    },
    "SpecDiffOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "spec.diff",
          "title": "Kind",
          "type": "string"
        },
        "new": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "New",
          "type": "string"
        },
        "old": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Old",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "old",
        "new"
      ],
      "title": "SpecDiffOperation",
      "type": "object"
    },
    "SpecValidateOperation": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Document",
          "type": "string"
        },
        "kind": {
          "const": "spec.validate",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "title": "SpecValidateOperation",
      "type": "object"
    },
    "WorkspaceShowOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "workspace.show",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "WorkspaceShowOperation",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/application-command/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One identity-bound command. Callers supply identity, time, and expected head.",
  "properties": {
    "actorId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Actorid",
      "type": "string"
    },
    "apiVersion": {
      "const": "researchos.dev/application/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "commandId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Commandid",
      "type": "string"
    },
    "expectedHead": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expectedhead"
    },
    "expectedRevision": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expectedrevision"
    },
    "kind": {
      "const": "ApplicationCommand",
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "discriminator": {
        "mapping": {
          "plan.dry-run": "#/$defs/PlanDryRunOperation",
          "research.decision": "#/$defs/ResearchDecisionOperation",
          "research.ledger": "#/$defs/ResearchLedgerOperation",
          "revision.list": "#/$defs/RevisionListOperation",
          "run.show": "#/$defs/RunShowOperation",
          "run.simulate": "#/$defs/RunSimulateOperation",
          "spec.diff": "#/$defs/SpecDiffOperation",
          "spec.validate": "#/$defs/SpecValidateOperation",
          "workspace.show": "#/$defs/WorkspaceShowOperation"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SpecValidateOperation"
        },
        {
          "$ref": "#/$defs/SpecDiffOperation"
        },
        {
          "$ref": "#/$defs/PlanDryRunOperation"
        },
        {
          "$ref": "#/$defs/ResearchLedgerOperation"
        },
        {
          "$ref": "#/$defs/ResearchDecisionOperation"
        },
        {
          "$ref": "#/$defs/RevisionListOperation"
        },
        {
          "$ref": "#/$defs/RunShowOperation"
        },
        {
          "$ref": "#/$defs/RunSimulateOperation"
        },
        {
          "$ref": "#/$defs/WorkspaceShowOperation"
        }
      ],
      "title": "Operation"
    },
    "submittedAt": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Submittedat",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "commandId",
    "actorId",
    "submittedAt",
    "operation"
  ],
  "title": "ApplicationCommand",
  "type": "object"
}
