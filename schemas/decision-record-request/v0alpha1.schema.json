      "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$",
      "title": "Subject",
      "type": "string"
    },
    "targetId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Targetid",
      "type": "string"
    },
    "targetKind": {
      "$ref": "#/$defs/DecisionTargetKind"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "projectId",
    "experimentRevision",
    "source",
    "subject",
    "streamid",
    "actor",
    "event",
    "decisionId",
    "targetKind",
    "targetId",
    "outcome",
    "rationale",
    "overriddenDissentIds",
    "evidenceRefs"
  ],
  "title": "DecisionRecordRequestDocument",
  "type": "object"
}
