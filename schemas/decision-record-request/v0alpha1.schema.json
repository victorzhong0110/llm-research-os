{
  "$defs": {
    "DecisionOutcome": {
      "enum": [
        "accept",
        "reject",
        "modify",
        "continue",
        "defer"
      ],
      "title": "DecisionOutcome",
      "type": "string"
    },
    "DecisionRequestActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "policy"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "DecisionRequestActor",
      "type": "object"
    },
    "DecisionTargetKind": {
      "enum": [
        "proposal",
        "run",
        "dissent"
      ],
      "title": "DecisionTargetKind",
      "type": "string"
    },
    "ResearchEventIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$",
          "title": "Id",
          "type": "string"
        },
        "time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "time"
      ],
      "title": "ResearchEventIdentity",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/decision-record-request/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/DecisionRequestActor"
    },
    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "decisionId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Decisionid",
      "type": "string"
    },
    "event": {
      "$ref": "#/$defs/ResearchEventIdentity"
    },
    "evidenceRefs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Evidencerefs",
      "type": "array",
      "uniqueItems": true
    },
    "experimentRevision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Experimentrevision",
      "type": "integer"
    },
    "kind": {
      "const": "DecisionRecordRequest",
      "title": "Kind",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/DecisionOutcome"
    },
    "overriddenDissentIds": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Overriddendissentids",
      "type": "array",
      "uniqueItems": true
    },
    "projectId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Projectid",
      "type": "string"
    },
