{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "https://researchos.dev/schemas/native-reviewed-task-output/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "attemptId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Attemptid",
      "type": "string"
    },
    "kind": {
      "const": "NativeReviewedTaskOutput",
      "title": "Kind",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/JsonValue"
    },
    "requestDigest": {
      "pattern": "^jcs-sha256:[0-9a-f]{64}$",
      "title": "Requestdigest",
      "type": "string"
    },
    "runId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Runid",
      "type": "string"
    },
    "taskId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Taskid",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "requestDigest",
    "taskId",
    "runId",
    "attemptId",
    "output"
  ],
  "title": "NativeReviewedTaskOutput",
  "type": "object"
}
