{
  "$id": "https://researchos.dev/schemas/research-model-profile/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "researchos.dev/application/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "baseArtifact": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Baseartifact",
      "type": "string"
    },
    "candidateArtifact": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidateartifact",
      "type": "string"
    },
    "fixture": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$",
      "title": "Fixture",
      "type": "string"
    },
    "kind": {
      "const": "ResearchModelProfile",
      "title": "Kind",
      "type": "string"
    },
    "request": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$",
      "title": "Request",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "request",
    "fixture",
    "baseArtifact",
    "candidateArtifact"
  ],
  "title": "ResearchModelProfile",
  "type": "object"
}
