{
  "$defs": {
    "PlanAuthorizationEventBinding": {
      "additionalProperties": false,
      "description": "Exact plan and recomputed decision identity.",
      "properties": {
        "decisionDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Decisiondigest",
          "type": "string"
        },
        "planDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Plandigest",
          "type": "string"
        },
        "registryDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Registrydigest",
          "type": "string"
        },
        "specDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Specdigest",
          "type": "string"
        }
      },
      "required": [
        "specDigest",
        "registryDigest",
        "planDigest",
        "decisionDigest"
      ],
      "title": "PlanAuthorizationEventBinding",
      "type": "object"
    },
    "PlanAuthorizationLineageBinding": {
      "additionalProperties": false,
      "description": "Plan identity used to locate recorded evaluation facts.\n\n``specDigest``, ``registryDigest`` and ``planDigest`` are required. They are\nthe fields a current RunSnapshot already carries. ``decisionDigest`` is\noptional: omit it to return every recorded evaluation of that plan identity;\nsupply it to restrict the candidate set to one exact decision.",
      "properties": {
        "decisionDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "type": "string"
        },
        "planDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Plandigest",
          "type": "string"
        },
        "registryDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Registrydigest",
          "type": "string"
        },
        "specDigest": {
          "pattern": "^(?:jcs-sha256|sha256):[0-9a-f]{64}$",
          "title": "Specdigest",
          "type": "string"
        }
      },
      "required": [
        "specDigest",
        "registryDigest",
        "planDigest"
      ],
      "title": "PlanAuthorizationLineageBinding",
      "type": "object"
    },
    "PlanAuthorizationLineageMatch": {
      "additionalProperties": false,
      "description": "One recorded evaluation fact located by the lineage query.\n\nThis is a citation into the event log.  It is not a launch credential.",
      "properties": {
        "actorId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Actorid",
          "type": "string"
        },
        "approvalAuthentication": {
          "const": "not-authenticated",
          "title": "Approvalauthentication",
          "type": "string"
        },
        "authority": {
          "const": "audit-only",
          "title": "Authority",
          "type": "string"
        },
        "authorized": {
          "title": "Authorized",
          "type": "boolean"
        },
        "binding": {
          "$ref": "#/$defs/PlanAuthorizationEventBinding"
        },
        "eventId": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$",
          "title": "Eventid",
          "type": "string"
        },
        "execution": {
          "const": "not-executed",
          "title": "Execution",
          "type": "string"
        },
        "sequence": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/PlanAuthorizationStatus"
        },
        "streamid": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Streamid",
          "type": "string"
        },
        "time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Time",
          "type": "string"
        },
        "workflowId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Workflowid",
          "type": "string"
        }
      },
      "required": [
        "eventId",
        "sequence",
        "time",
        "streamid",
        "actorId",
        "workflowId",
        "status",
        "authorized",
        "binding",
        "approvalAuthentication",
        "authority",
        "execution"
      ],
      "title": "PlanAuthorizationLineageMatch",
      "type": "object"
    },
    "PlanAuthorizationLineageQueryDocument": {
      "additionalProperties": false,
      "description": "Caller-owned identity used to reconstruct authorization audit facts.",
      "properties": {
        "apiVersion": {
          "const": "researchos.dev/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/PlanAuthorizationLineageBinding"
        },
        "experimentRevision": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Experimentrevision",
          "type": "integer"
        },
        "kind": {
          "const": "PlanAuthorizationLineageQuery",
          "title": "Kind",
          "type": "string"
        },
        "projectId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Projectid",
          "type": "string"
        },
        "workflowId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Workflowid",
          "type": "string"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "projectId",
        "experimentRevision",
        "workflowId",
        "binding"
      ],
      "title": "PlanAuthorizationLineageQueryDocument",
      "type": "object"
    },
    "PlanAuthorizationSideEffects": {
      "additionalProperties": false,
      "description": "Literal zero-effect declaration for this evaluation command.",
      "properties": {
        "blocksExecuted": {
          "const": 0,
          "title": "Blocksexecuted",
          "type": "integer"
        },
        "networkRequests": {
          "const": 0,
          "title": "Networkrequests",
          "type": "integer"
        },
        "paidActions": {
          "const": 0,
          "title": "Paidactions",
          "type": "integer"
        },
        "persistentWrites": {
          "const": 0,
          "title": "Persistentwrites",
          "type": "integer"
        }
      },
      "required": [
        "blocksExecuted",
        "networkRequests",
        "persistentWrites",
        "paidActions"
      ],
      "title": "PlanAuthorizationSideEffects",
      "type": "object"
    },
    "PlanAuthorizationStatus": {
      "description": "Outcome of evaluating one policy input against one exact plan.",
      "enum": [
        "authorized",
        "pending",
        "denied"
      ],
      "title": "PlanAuthorizationStatus",
      "type": "string"
    }
  },
  "$id": "https://researchos.dev/schemas/plan-authorization-lineage-report/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read-only reconstruction of matching audit-only authorization facts.",
  "properties": {
    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "approvalAuthentication": {
      "const": "not-authenticated",
      "title": "Approvalauthentication",
      "type": "string"
    },
    "authority": {
      "const": "audit-only",
      "title": "Authority",
      "type": "string"
    },
    "execution": {
      "const": "not-executed",
      "title": "Execution",
      "type": "string"
    },
    "highWaterSequence": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Highwatersequence",
      "type": "integer"
    },
    "kind": {
      "const": "PlanAuthorizationLineageReport",
      "title": "Kind",
      "type": "string"
    },
    "matchCount": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Matchcount",
      "type": "integer"
    },
    "matches": {
      "items": {
        "$ref": "#/$defs/PlanAuthorizationLineageMatch"
      },
      "title": "Matches",
      "type": "array"
    },
    "persistence": {
      "const": "read-only",
      "title": "Persistence",
      "type": "string"
    },
    "query": {
      "$ref": "#/$defs/PlanAuthorizationLineageQueryDocument"
    },
    "runtimeConsumption": {
      "const": "not-consumed",
      "title": "Runtimeconsumption",
      "type": "string"
    },
    "sideEffects": {
      "$ref": "#/$defs/PlanAuthorizationSideEffects"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "query",
    "matchCount",
    "matches",
    "highWaterSequence",
    "approvalAuthentication",
    "authority",
    "execution",
    "runtimeConsumption",
    "persistence",
    "sideEffects"
  ],
  "title": "PlanAuthorizationLineageReport",
  "type": "object"
}
