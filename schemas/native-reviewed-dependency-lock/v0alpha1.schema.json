{
  "$defs": {
    "NativeReviewedPackagePin": {
      "additionalProperties": false,
      "description": "Identity of one reviewed distribution. Preparation does not install it.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "digest"
      ],
      "title": "NativeReviewedPackagePin",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/native-reviewed-dependency-lock/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reviewed lock identity. No install scripts or URLs are accepted.",
  "properties": {
    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "NativeReviewedDependencyLock",
      "title": "Kind",
      "type": "string"
    },
    "packages": {
      "items": {
        "$ref": "#/$defs/NativeReviewedPackagePin"
      },
      "maxItems": 32,
      "title": "Packages",
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "packages"
  ],
  "title": "NativeReviewedDependencyLock",
  "type": "object"
}
