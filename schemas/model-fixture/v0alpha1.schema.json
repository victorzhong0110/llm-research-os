{
  "$id": "https://researchos.dev/schemas/model-fixture/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Local fixture used by ``DeterministicMockProvider``. Prompt/output stay off events.",
  "properties": {
    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "ModelFixture",
      "title": "Kind",
      "type": "string"
    },
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "prompt": {
      "additionalProperties": true,
      "title": "Prompt",
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "id",
    "prompt",
    "output"
  ],
  "title": "ModelFixtureDocument",
  "type": "object"
}
