{
  "$defs": {
    "DataUse": {
      "enum": [
        "research-read",
        "retrieval",
        "training",
        "redistribution"
      ],
      "title": "DataUse",
      "type": "string"
    },
    "EvidenceEventIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$",
          "title": "Id",
          "type": "string"
        },
        "time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "time"
      ],
      "title": "EvidenceEventIdentity",
      "type": "object"
    },
    "EvidenceRequestActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "system"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "EvidenceRequestActor",
      "type": "object"
    },
    "EvidenceSourceType": {
      "enum": [
        "paper",
        "code",
        "note",
        "dataset",
        "web",
        "experiment",
        "other"
      ],
      "title": "EvidenceSourceType",
      "type": "string"
    },
    "RightsStatus": {
      "enum": [
        "allowed",
        "restricted",
        "unknown"
      ],
      "title": "RightsStatus",
      "type": "string"
    }
  },
  "$id": "https://researchos.dev/schemas/evidence-import-request/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/EvidenceRequestActor"
    },
    "allowedUses": {
      "default": [
        "research-read"
      ],
      "items": {
        "$ref": "#/$defs/DataUse"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Alloweduses",
      "type": "array",
      "uniqueItems": true
    },
    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "event": {
      "$ref": "#/$defs/EvidenceEventIdentity"
    },
    "evidenceId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Evidenceid",
      "type": "string"
    },
    "evidenceRefs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Evidencerefs",
      "type": "array",
      "uniqueItems": true
    },
    "experimentRevision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Experimentrevision",
      "type": "integer"
    },
    "kind": {
      "const": "EvidenceImportRequest",
      "title": "Kind",
      "type": "string"
    },
    "license": {
      "default": "LicenseRef-Unknown",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "title": "License",
      "type": "string"
    },
    "mediaType": {
      "enum": [
        "text/markdown",
        "application/pdf"
      ],
      "title": "Mediatype",
      "type": "string"
    },
    "projectId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Projectid",
      "type": "string"
    },
    "rights": {
      "$ref": "#/$defs/RightsStatus",
      "default": "unknown"
    },
