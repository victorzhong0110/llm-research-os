  },
  "required": [
    "apiVersion",
    "kind",
    "projectId",
    "experimentRevision",
    "source",
    "subject",
    "streamid",
    "actor",
    "event",
    "questionId",
    "answer",
    "rights",
    "evidenceRefs"
  ],
  "title": "QuestionAnswerRequestDocument",
  "type": "object"
}
