{
  "$defs": {
    "AnswerRequestActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "human",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "AnswerRequestActor",
      "type": "object"
    },
    "AnswerRights": {
      "additionalProperties": false,
      "not": {
        "properties": {
          "allowedUses": {
            "contains": {
              "enum": [
                "redistribution",
                "training"
              ]
            }
          },
          "status": {
            "const": "unknown"
          }
        },
        "required": [
          "allowedUses",
          "status"
        ]
      },
      "properties": {
        "allowedUses": {
          "default": [
            "research-read"
          ],
          "items": {
            "$ref": "#/$defs/DataUse"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Alloweduses",
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "$ref": "#/$defs/RightsStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "AnswerRights",
      "type": "object"
    },
    "DataUse": {
      "enum": [
        "research-read",
        "retrieval",
        "training",
        "redistribution"
      ],
      "title": "DataUse",
      "type": "string"
    },
    "QuestionAnswerValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "option": {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "option"
          ],
          "type": "object"
        }
      ]
    },
    "ResearchEventIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$",
          "title": "Id",
          "type": "string"
        },
        "time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "time"
      ],
      "title": "ResearchEventIdentity",
      "type": "object"
    },
    "RightsStatus": {
      "enum": [
        "allowed",
        "restricted",
        "unknown"
      ],
      "title": "RightsStatus",
      "type": "string"
    }
  },
  "$id": "https://researchos.dev/schemas/question-answer-request/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/AnswerRequestActor"
    },
    "answer": {
      "$ref": "#/$defs/QuestionAnswerValue"
    },
    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "event": {
      "$ref": "#/$defs/ResearchEventIdentity"
    },
    "evidenceRefs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Evidencerefs",
      "type": "array",
      "uniqueItems": true
    },
    "experimentRevision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Experimentrevision",
      "type": "integer"
    },
    "kind": {
      "const": "QuestionAnswerRequest",
      "title": "Kind",
      "type": "string"
    },
    "projectId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Projectid",
      "type": "string"
    },
    "questionId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Questionid",
      "type": "string"
    },
    "rights": {
      "$ref": "#/$defs/AnswerRights"
    },
