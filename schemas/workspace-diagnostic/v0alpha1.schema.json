{
  "$defs": {
    "DiagnosticCheck": {
      "additionalProperties": false,
      "description": "One named result. ``detail`` carries counts and identifiers, never a host path.",
      "properties": {
        "detail": {
          "additionalProperties": true,
          "title": "Detail",
          "type": "object"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9.-]*$",
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "warning",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "title": "DiagnosticCheck",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/workspace-diagnostic/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Redacted workspace diagnostics, safe to share before it is inspected.",
  "properties": {
    "apiVersion": {
      "default": "researchos.dev/recovery/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/DiagnosticCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "generatedAt": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Generatedat",
      "type": "string"
    },
    "healthy": {
      "title": "Healthy",
      "type": "boolean"
    },
    "kind": {
      "const": "WorkspaceDiagnostic",
      "default": "WorkspaceDiagnostic",
      "title": "Kind",
      "type": "string"
    },
    "projectId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projectid"
    },
    "pythonVersion": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Pythonversion",
      "type": "string"
    },
    "schemaVersion": {
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    }
  },
  "required": [
    "healthy",
    "generatedAt",
    "pythonVersion",
    "schemaVersion",
    "checks"
  ],
  "title": "DiagnosticReport",
  "type": "object"
}
