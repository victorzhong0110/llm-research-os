{
  "$defs": {
    "PlanAuthorizationEventActor": {
      "additionalProperties": false,
      "description": "Caller-asserted actor identity; this is not authentication.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "PlanAuthorizationEventActor",
      "type": "object"
    },
    "PlanAuthorizationEventBinding": {
      "additionalProperties": false,
      "description": "Exact plan and recomputed decision identity.",
      "properties": {
        "decisionDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Decisiondigest",
          "type": "string"
        },
        "planDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Plandigest",
          "type": "string"
        },
        "registryDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Registrydigest",
          "type": "string"
        },
        "specDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Specdigest",
          "type": "string"
        }
      },
      "required": [
        "specDigest",
        "registryDigest",
        "planDigest",
        "decisionDigest"
      ],
      "title": "PlanAuthorizationEventBinding",
      "type": "object"
    },
    "PlanAuthorizationEventIdentity": {
      "additionalProperties": false,
      "description": "Caller-owned CloudEvents identity for the one appended fact.",
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$",
          "title": "Id",
          "type": "string"
        },
        "time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "time"
      ],
      "title": "PlanAuthorizationEventIdentity",
      "type": "object"
    }
  },
