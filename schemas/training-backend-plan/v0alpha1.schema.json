{
  "$id": "https://researchos.dev/schemas/training-backend-plan/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One pinned ms-swift SFT plan. Extra fields and other backends fail closed.",
  "properties": {
    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "backendId": {
      "const": "ms-swift",
      "title": "Backendid",
      "type": "string"
    },
    "backendVersion": {
      "const": "4.5.2",
      "title": "Backendversion",
      "type": "string"
    },
    "dataset": {
      "const": "AI-ModelScope/alpaca-gpt4-data-en#8",
      "title": "Dataset",
      "type": "string"
    },
    "gradientAccumulationSteps": {
      "const": 1,
      "title": "Gradientaccumulationsteps",
      "type": "integer"
    },
    "kind": {
      "const": "TrainingBackendPlan",
      "title": "Kind",
      "type": "string"
    },
    "learningRate": {
      "const": "1e-4",
      "title": "Learningrate",
      "type": "string"
    },
    "loggingSteps": {
      "const": 1,
      "title": "Loggingsteps",
      "type": "integer"
    },
    "loraAlpha": {
      "const": 16,
      "title": "Loraalpha",
      "type": "integer"
    },
    "loraRank": {
      "const": 8,
      "title": "Lorarank",
      "type": "integer"
    },
    "maxLength": {
      "const": 512,
      "title": "Maxlength",
      "type": "integer"
    },
    "maxSteps": {
      "const": 1,
      "title": "Maxsteps",
      "type": "integer"
    },
    "model": {
      "const": "Qwen/Qwen2.5-0.5B-Instruct",
      "title": "Model",
      "type": "string"
    },
    "outputDir": {
      "const": "/work/output",
      "title": "Outputdir",
      "type": "string"
    },
    "perDeviceTrainBatchSize": {
      "const": 1,
      "title": "Perdevicetrainbatchsize",
      "type": "integer"
    },
    "saveSteps": {
      "const": 1,
      "title": "Savesteps",
      "type": "integer"
    },
    "torchDtype": {
      "const": "bfloat16",
      "title": "Torchdtype",
      "type": "string"
    },
    "tunerType": {
      "const": "lora",
      "title": "Tunertype",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "backendId",
    "backendVersion",
    "model",
    "dataset",
    "tunerType",
    "torchDtype",
    "maxSteps",
    "perDeviceTrainBatchSize",
    "gradientAccumulationSteps",
    "learningRate",
    "loraRank",
    "loraAlpha",
    "outputDir",
    "saveSteps",
    "loggingSteps",
    "maxLength"
  ],
  "title": "TrainingBackendPlan",
  "type": "object"
}
