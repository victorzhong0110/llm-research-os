{
  "$defs": {
    "EventActor": {
      "additionalProperties": false,
      "description": "Closed actor identity. Additional actor facets are not part of v0alpha1.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "EventActor",
      "type": "object"
    },
    "ResearchEventData": {
      "additionalProperties": false,
      "description": "Versioned ResearchEvent domain payload carried in CloudEvents ``data``.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/EventActor"
        },
        "attemptId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attemptid"
        },
        "blockId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blockid"
        },
        "evidenceRefs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array",
          "uniqueItems": true
        },
        "experimentRevision": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Experimentrevision",
          "type": "integer"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "projectId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Projectid",
          "type": "string"
        },
        "runId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runid"
        },
        "schemaVersion": {
          "const": "v0alpha1",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "actor",
        "projectId",
        "experimentRevision",
        "payload",
        "evidenceRefs"
      ],
      "title": "ResearchEventData",
      "type": "object"
    }
  },
