          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "time"
      ],
      "title": "RunCancellationEventIdentity",
      "type": "object"
    },
    "RunCancellationTarget": {
      "additionalProperties": false,
      "description": "Request cancellation for the Run aggregate without claiming an outcome.",
      "properties": {
        "kind": {
          "const": "run",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RunCancellationTarget",
      "type": "object"
    }
  },
