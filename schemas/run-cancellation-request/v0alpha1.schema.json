          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "RunCancellationActor",
      "type": "object"
    },
    "RunCancellationEventIdentity": {
      "additionalProperties": false,
      "description": "Caller-owned CloudEvents identity for the one appended request fact.",
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$",
