{
  "$defs": {
    "AttemptCancellationTarget": {
      "additionalProperties": false,
      "description": "Request cancellation for one active Attempt without claiming it stopped.",
      "properties": {
        "attemptId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Attemptid",
          "type": "string"
        },
        "kind": {
          "const": "attempt",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "attemptId"
      ],
      "title": "AttemptCancellationTarget",
      "type": "object"
    },
    "RunCancellationActor": {
      "additionalProperties": false,
      "description": "Caller-owned actor identity for the cancellation request fact.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
