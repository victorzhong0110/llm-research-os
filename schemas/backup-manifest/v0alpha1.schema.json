{
  "$defs": {
    "BackupObject": {
      "additionalProperties": false,
      "description": "One immutable content-addressed object copied into the image.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "sizeBytes": {
          "minimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        },
        "storageKey": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Storagekey",
          "type": "string"
        }
      },
      "required": [
        "digest",
        "sizeBytes",
        "storageKey"
      ],
      "title": "BackupObject",
      "type": "object"
    }
  },
  "$id": "https://researchos.dev/schemas/backup-manifest/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Self-describing backup image header. Restore trusts only what it re-verifies.",
  "properties": {
    "apiVersion": {
      "default": "researchos.dev/recovery/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Createdat",
      "type": "string"
    },
    "eventCount": {
      "minimum": 0,
      "title": "Eventcount",
      "type": "integer"
    },
    "highWater": {
      "minimum": 0,
      "title": "Highwater",
      "type": "integer"
    },
    "kind": {
      "const": "BackupManifest",
      "default": "BackupManifest",
      "title": "Kind",
      "type": "string"
    },
    "lastEventDigest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lasteventdigest"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/BackupObject"
      },
      "maxItems": 100000,
      "title": "Objects",
      "type": "array"
    },
    "projectId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Projectid",
      "type": "string"
    },
    "relaunchPolicy": {
      "const": "not-relaunched",
      "default": "not-relaunched",
      "title": "Relaunchpolicy",
      "type": "string"
    },
    "schemaDigest": {
      "minLength": 1,
      "title": "Schemadigest",
      "type": "string"
    },
    "schemaVersion": {
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "snapshotBytes": {
      "minimum": 1,
      "title": "Snapshotbytes",
      "type": "integer"
    },
    "snapshotDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Snapshotdigest",
      "type": "string"
    },
    "totalObjectBytes": {
      "minimum": 0,
      "title": "Totalobjectbytes",
      "type": "integer"
    }
  },
  "required": [
    "projectId",
    "createdAt",
    "highWater",
    "eventCount",
    "schemaVersion",
    "schemaDigest",
    "snapshotDigest",
    "snapshotBytes",
    "objects",
    "totalObjectBytes"
  ],
  "title": "BackupManifest",
  "type": "object"
}
