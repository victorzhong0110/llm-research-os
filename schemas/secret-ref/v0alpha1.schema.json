{
  "$defs": {
    "SecretBackend": {
      "enum": [
        "env",
        "file",
        "keyring"
      ],
      "title": "SecretBackend",
      "type": "string"
    }
  },
  "$id": "https://researchos.dev/schemas/secret-ref/v0alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Handle to a secret slot. Callers must not place the secret value here.",
  "properties": {
    "apiVersion": {
      "const": "researchos.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "backend": {
      "$ref": "#/$defs/SecretBackend"
    },
    "kind": {
      "const": "SecretRef",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Name",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "backend",
    "name"
  ],
  "title": "SecretRef",
  "type": "object"
}
